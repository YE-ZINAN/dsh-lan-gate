# 运行日志（含访问 IP、设备名，不该进仓库）
run.log
run.err.log
# 轮转保留下来的上一次日志（同样含 IP 与设备名）
run.log.prev
run.err.log.prev
*.tmp

# 本地状态与密钥 —— 真实位置在 ~/.dsh/ 下，这里只是兜底
lan-gate-state.json
lan-gate-secret
lan-gate-domreport.json

# 脚本运行残留（lan-gate.ps1 / 诊断脚本会生成）
r[0-9].txt
s[0-9].txt
e[0-9].txt
status-out.txt
status-err.txt

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.bak
*.orig

# 生成文档时留下的临时脚本（踩过：被误提交进初始提交）
.tmp-*
*.tmp-*

# 计划任务定义的备份（含本机计算机名、用户 SID 与本地绝对路径）
tools/autostart-task-backup*.xml
